# ==========================================
# MERCADOLIBRE ERP 2026 - EJEMPLO DE ENTORNO
# ==========================================
# Copia este archivo como .env.local y completa los valores correspondientes.
# NUNCA subas credenciales reales a GitHub.

# 1. Supabase (Base de datos y Auth)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_tu_clave_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_aqui

# 2. Mercado Libre Venezuela (OAuth2)
MELI_CLIENT_ID=tu_client_id_meli
MELI_CLIENT_SECRET=tu_client_secret_meli
MELI_REDIRECT_URI=http://localhost:3000/api/auth/callback/ml

# 3. Google Gemini 3.6 Flash (Pool Multi-Key para Títulos SEO y Fichas Técnicas)
# Puedes usar 1, 2, 3 o 4 claves independientes para sumar hasta 60 RPM gratuitas.
GEMINI_API_KEY=AIzaSy...clave_1
GEMINI_API_KEY_2=AIzaSy...clave_2
GEMINI_API_KEY_3=AIzaSy...clave_3
GEMINI_API_KEY_4=AIzaSy...clave_4

# 4. Groq (Opcional - Motor Llama 3 para Sniper y Optimizer)
GROQ_API_KEY=gsk_tu_clave_groq_aqui

# 5. Microservicio Scrapling (Anti-Bot Bypass Anubis)
SCRAPLING_SERVICE_URL=http://localhost:8000
