# =============================================================================
# Plantilla para supabase/docker/.env (self-hosted en R630)
# Copiar a /opt/supabase/docker/.env — NO commitear con valores reales
# =============================================================================
# Generar JWT: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# Guía: scripts/setup-coolify-r630.md
# =============================================================================

############
# Secrets  — CAMBIAR TODOS antes de producción
############

POSTGRES_PASSWORD=change-me-strong-postgres-password
JWT_SECRET=change-me-long-random-jwt-secret-min-32-chars
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-generated-anon-key
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-generated-service-role-key
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-studio-password

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# API y Studio — URLs vistas desde clientes LAN (Windows)
############

SITE_URL=http://192.168.1.88:54321
API_EXTERNAL_URL=http://192.168.1.88:54321
SUPABASE_PUBLIC_URL=http://192.168.1.88:54321

############
# Auth (GoTrue)
############

ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://192.168.1.88:3000/**
DISABLE_SIGNUP=false
JWT_EXPIRY=3600

############
# Correo (opcional — Inbucket en dev)
############

SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ERP MercadoLibre

############
# Storage
############

STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

############
# Realtime / Analytics — defaults del repo oficial suelen bastar
############

# Ver .env.example completo en github.com/supabase/supabase/tree/master/docker
