# =============================================================================
# Variables de entorno — Next.js ERP en Coolify (R630 @ 192.168.1.88)
# Pegar en Coolify → Application → Environment Variables
# NO commitear con valores reales
# =============================================================================
# Guía: scripts/setup-coolify-r630.md
# Para publicación con fotos locales, preferir npm run dev en Windows.
# =============================================================================

# --- Supabase LAN (mismo stack que deploy/coolify/.env.example) ---
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.88:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...anon_from_supabase_docker_env
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_from_supabase_docker_env
SUPABASE_URL=http://192.168.1.88:54321

# Conexión directa Postgres (scripts server-side, migraciones)
DIRECT_URL=postgresql://postgres:POSTGRES_PASSWORD@192.168.1.88:54322/postgres
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@192.168.1.88:54322/postgres

# --- App ---
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://192.168.1.88:3000

# --- Mercado Libre OAuth ---
# Redirect URI debe coincidir con la URL pública de esta app en Coolify
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://192.168.1.88:3000/api/auth/callback

# --- Cron / seguridad ---
CRON_SECRET=change-me-random-cron-secret

# --- IA (opcional) ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- Scraping (opcional; servicio externo) ---
# SCRAPLING_SERVICE_URL=http://192.168.1.x:8765

# --- Fotos locales vía Samba (solo si montaste //PC/FOTOS en el CT) ---
# PHOTOS_PATH=/mnt/fotos
